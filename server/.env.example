# Server Port
PORT=5000

# MongoDB Connection (MongoDB Atlas or local instance).
# Leave empty to use automatic embedded in-memory MongoDB engine for local zero-config testing.
MONGODB_URI=

# JWT Secret for authentication tokens
JWT_SECRET=clipping_super_secret_jwt_key_2026_change_in_production

# Google Gemini API Configuration
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Client URL for CORS
CLIENT_URL=http://localhost:5173
